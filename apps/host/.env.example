# Copy to .env.local (gitignored) and adjust per environment.
#
# IMPORTANT: this must match apps/main-app/.env and
# apps/ai-control-tower/.env exactly. @platform/api-client is consumed as
# raw source and bundled independently by each Vite app (it isn't a
# pre-built package), so import.meta.env.VITE_USE_MOCK_API gets replaced
# with whatever THIS app's own .env says — a mismatch across the three
# apps means one silently serves mock data while another calls a real
# backend for the exact same shared service.

# false once a real backend exists (Phase 22) — true (or unset) uses the
# mock data every *-service.ts in @platform/api-client ships with.
VITE_USE_MOCK_API=true

# Only read when VITE_USE_MOCK_API=false.
VITE_API_BASE_URL=http://localhost:8000
